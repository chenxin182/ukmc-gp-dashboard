# ── Deal Radar — environment variables ──────────────────────────────────────

# Database (defaults to SQLite in ./deal_radar.db)
# DEAL_RADAR_DB_URL=postgresql://user:pass@localhost/deal_radar

# GitHub API token (increases rate limit from 60→5000 req/hr)
GITHUB_TOKEN=

# Twitter/X API v2 Bearer token (required for founder VC interaction signals)
TWITTER_BEARER_TOKEN=

# Daily email digest
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_RECIPIENTS=you@example.com,partner@example.com

# Feishu (Lark) bot webhook — https://open.feishu.cn/open-apis/bot/v2/hook/<token>
FEISHU_WEBHOOK_URL=

# Slack incoming webhook — https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_URL=
